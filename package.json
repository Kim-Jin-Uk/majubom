{
  "name": "majubom",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": "^11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:emu": "firebase emulators:exec --only firestore --project demo-majubom \"npm run test:rules\"",
    "verify": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:check": "tsx scripts/db/check-invariants.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "r2:cors": "node scripts/dev/r2-cors.mjs",
    "r2:verify": "tsx scripts/dev/verify-r2.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@sentry/nextjs": "^10",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "pg": "^8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17",
    "drizzle-kit": "^0.31",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "firebase": "^12",
    "firebase-tools": "^15",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "~4.1.0"
  }
}
