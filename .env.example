# ─────────────────────────────────────────────────────────────
# 이 파일만 커밋한다. 실제 값은 .env.local (로컬) / Secret Manager (배포)
# ─────────────────────────────────────────────────────────────

# ── 예약 DB (Neon Postgres) ── 둘 다 필수
# 런타임(pooled):  postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/majubom?sslmode=verify-full
# 마이그레이션(직결): 같은 주소에서 -pooler 를 뺀 것. scripts/db/* 는 pooled 주소를 거부한다
# sslmode 는 verify-full 로 명시한다 — pg 8 은 require 를 verify-full 로 취급하며 경고를 낸다
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── 1기 게이트 (W1–W15) ── 08 §3.1
GATE_ENABLED=true
# user:pass — 설정하면 Basic Auth. /api/auth/* · /api/health 는 예외
GATE_BASIC_AUTH=

# ── 기능 플래그 (서버 전용 — NEXT_PUBLIC_ 금지) ── 08 §2.3
FEATURE_BUILDER=false
FEATURE_CHAT=false

# ── Auth.js v5 ──
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Firebase (클라이언트 — 공개돼도 되는 값) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Firebase Admin (서버 — 절대 공개 금지) ──
# JSON 키 파일을 커밋하지 말고 이 3개 값만 쓴다
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── 스토리지 (Cloudflare R2) ── 다섯 개는 세트. 각 값이 어디서 오는지:
# ACCOUNT_ID      = S3 엔드포인트 https://<이것>.r2.cloudflarestorage.com 의 앞부분 (32자 hex). cfat_ 토큰 값이 아니다
# ACCESS_KEY_ID   = 토큰 화면 "Access Key ID" (32자 hex). Roll 해도 바뀌지 않는다
# SECRET_ACCESS_KEY = 토큰 화면 "Secret Access Key" (64자 hex). Roll 하면 이것만 바뀐다
# PUBLIC_BASE_URL = 버킷 Settings → Public Development URL (https://pub-….r2.dev). S3 엔드포인트가 아니다
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=majubom-media
R2_PUBLIC_BASE_URL=

# ── 메일 (Resend) ──
RESEND_API_KEY=
MAIL_FROM="마주,봄 <no-reply@majubom.kr>"

# ── 크론 (FR-INFRA-010) ──
CRON_SECRET=

# ── 지도 ──
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── 모니터링 (Sentry) ── DSN 없으면 초기화 skip
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
