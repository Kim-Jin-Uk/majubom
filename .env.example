# ─────────────────────────────────────────────────────────────
# 이 파일만 커밋한다. 실제 값은 .env.local (로컬) / Secret Manager (배포)
# ─────────────────────────────────────────────────────────────

# ── 예약 DB (Neon Postgres) ──
# postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/majubom?sslmode=require
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth.js v5 ──
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Firebase (클라이언트 — 공개돼도 되는 값) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Firebase Admin (서버 — 절대 공개 금지) ──
# JSON 키 파일을 커밋하지 말고 이 3개 값만 쓴다
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── 스토리지 (Cloudflare R2) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=majubom-media
R2_PUBLIC_BASE_URL=

# ── 메일 (Resend) ──
RESEND_API_KEY=
MAIL_FROM="마주,봄 <no-reply@majubom.kr>"

# ── 크론 (FR-INFRA-010) ──
CRON_SECRET=

# ── 지도 ──
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── 모니터링 ──
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
